{
  "$schema": "https://typedoc.org/schema.json",
  "name": "mcp-use TypeScript API",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/server",
    "packages/client",
    "packages/agent",
    "packages/tunnel"
  ],
  "plugin": ["./scripts/typedoc-navigation-plugin.mjs"],
  "theme": "mcp-use",
  "out": ".typedoc",
  "readme": "none",
  "includeVersion": false,
  "cleanOutputDir": true,
  "githubPages": false,
  "treatWarningsAsErrors": true
}
