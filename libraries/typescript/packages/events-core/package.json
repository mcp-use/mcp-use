{
  "name": "@mcp-use/events-core",
  "type": "module",
  "version": "0.0.0",
  "description": "MCP Events (SEP-3415 and the ChatGPT dialect) wire contract for mcp-use: wire types, delivery profiles, known clients, error codes, subscription ids, Standard Webhooks signing and header codecs. Zero dependencies, WebCrypto only.",
  "author": "mcp-use, Inc.",
  "license": "MIT",
  "homepage": "https://github.com/mcp-use/mcp-use#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcp-use/mcp-use.git",
    "directory": "libraries/typescript/packages/events-core"
  },
  "bugs": {
    "url": "https://github.com/mcp-use/mcp-use/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "events",
    "webhooks",
    "standard-webhooks"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    },
    "./vectors/*": "./vectors/*"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "vectors",
    "README.md"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "rimraf dist && tsup && tsc --emitDeclarationOnly --declaration && rimraf dist/.tsbuildinfo",
    "test": "vitest run",
    "test:run": "pnpm typecheck && pnpm test",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "rimraf": "^6.1.3",
    "standardwebhooks": "1.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
