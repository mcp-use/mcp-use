{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "rootDir": "src",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": false,
    "noEmit": false,
    "outDir": "dist",
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/server/**/*", "src/cli/**/*", "src/shared/**/*"],
  "exclude": ["src/client/**/*"]
}
