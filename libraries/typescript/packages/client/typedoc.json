{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/index-browser.ts", "src/react/index.ts"],
  "tsconfig": "tsconfig.json",
  "readme": "none",
  "validation": {
    "notDocumented": true,
    "invalidLink": true,
    "notExported": true
  },
  "treatWarningsAsErrors": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "intentionallyNotExported": [
    "BaseMCPClient",
    "BaseTelemetryEvent",
    "ConnectorInitEventData",
    "ElicitParams",
    "ExecutionResult",
    "HttpConnectorOptions",
    "KVStore",
    "MCPAgentExecutionEventData",
    "MCPClientInitEventData",
    "ProxyConfig",
    "RuntimeEnvironment",
    "SearchToolsFunction",
    "SimpleConsoleLogger",
    "StdioConnectorOptions",
    "StorageCapability",
    "ToolSearchResponse",
    "UseMcpInternalOptions",
    "ViewSandboxBlobUrlOptions"
  ],
  "intentionallyNotDocumented": [
    "index.CODE_MODE_AGENT_PROMPT",
    "index.setTelemetrySource",
    "index.setProductVersion",
    "index.Telemetry.getInstance",
    "index.Telemetry.runtimeEnvironment",
    "index.Telemetry.storageCapability",
    "index.Telemetry.setSource",
    "index.Telemetry.getSource",
    "index.Telemetry.setProductVersion",
    "index.Telemetry.isEnabled",
    "index.Telemetry.userId",
    "index.Telemetry.capture",
    "index.Telemetry.trackAgentExecution",
    "index.Telemetry.trackMCPClientInit",
    "index.Telemetry.trackConnectorInit",
    "index.Telemetry.trackClientAddServer",
    "index.Telemetry.trackClientRemoveServer",
    "index.Telemetry.trackUseMcpConnection",
    "index.Telemetry.trackUseMcpToolCall",
    "index.Telemetry.trackUseMcpResourceRead",
    "index.Telemetry.identify",
    "index.Telemetry.reset",
    "index.Telemetry.flush",
    "index.Telemetry.shutdown",
    "index.POSTHOG_HOST",
    "index.POSTHOG_API_KEY"
  ]
}
