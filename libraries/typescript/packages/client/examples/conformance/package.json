{
  "name": "conformance-client",
  "type": "module",
  "version": "1.0.0",
  "description": "MCP Conformance Test Clients for mcp-use TypeScript",
  "author": "",
  "license": "MIT",
  "keywords": [
    "mcp",
    "client",
    "conformance",
    "testing"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:conformance:client": "conformance client --command 'node --import tsx ./src/conformance-client-node.ts' --suite core --expected-failures ./expected-failures.yaml",
    "test:conformance:client:all": "conformance client --command 'node --import tsx ./src/conformance-client-node.ts' --suite all --expected-failures ./expected-failures.yaml",
    "test:conformance:client:2026": "conformance client --command 'node --import tsx ./src/conformance-client-node.ts' --suite all --spec-version 2026-07-28 --expected-failures ./expected-failures.2026-07-28.yaml",
    "test:conformance:server": "bash ./scripts/run-server-conformance.sh --expected-failures ./expected-failures.yaml",
    "test:conformance:server:draft": "bash ./scripts/run-server-conformance.sh --suite draft --expected-failures ./expected-failures.yaml",
    "test:conformance:server:extensions": "bash ./scripts/run-server-conformance.sh --suite all --expected-failures ./expected-failures.yaml",
    "test:conformance:server:all": "bash ./scripts/run-server-conformance.sh --suite all --expected-failures ./expected-failures.yaml",
    "test:conformance:server:2026": "bash ./scripts/run-server-conformance.sh --suite all --spec-version 2026-07-28 --expected-failures ./expected-failures.2026-07-28.yaml",
    "test:conformance:all": "pnpm run test:conformance:client:all && pnpm run test:conformance:server:all"
  },
  "dependencies": {
    "jsdom": "^27.0.0",
    "@mcp-use/client": "workspace:*",
    "react": "^19.2.3",
    "react-test-renderer": "^19.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.0.2",
    "@types/react-test-renderer": "^19.1.0",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.10",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
