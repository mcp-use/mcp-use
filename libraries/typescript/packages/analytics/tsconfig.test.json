{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "vitest/globals"],
    // SDK v1's published types (StreamableHTTPServerTransport, Transport)
    // do not satisfy exactOptionalPropertyTypes; src is still checked with it
    // by tsconfig.json.
    "exactOptionalPropertyTypes": false
  },
  "include": ["src/**/*", "tests/**/*", "vitest.config.ts", "tsup.config.ts"]
}
