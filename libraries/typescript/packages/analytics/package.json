{
  "name": "@mcp-use/analytics",
  "type": "module",
  "version": "0.0.0",
  "description": "Manufact analytics for MCP servers you host yourself: one instrument() call per server",
  "author": "mcp-use, Inc.",
  "license": "MIT",
  "homepage": "https://github.com/mcp-use/mcp-use#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcp-use/mcp-use.git",
    "directory": "libraries/typescript/packages/analytics"
  },
  "bugs": {
    "url": "https://github.com/mcp-use/mcp-use/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "analytics",
    "observability",
    "manufact"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rimraf dist && tsup",
    "test": "vitest run",
    "test:run": "pnpm typecheck && pnpm test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "catalog:",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "^22.20.0",
    "mcp-handler": "2.3.0",
    "mcp-use": "workspace:*",
    "rimraf": "^6.1.3",
    "skybridge": "2.0.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
