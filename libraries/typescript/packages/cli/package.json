{
  "name": "@mcp-use/cli",
  "type": "module",
  "version": "4.0.2-canary.0",
  "description": "Prebuilt CLI, development server, and build pipeline for mcp-use",
  "author": "mcp-use, Inc.",
  "license": "MIT",
  "homepage": "https://github.com/mcp-use/mcp-use#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcp-use/mcp-use.git",
    "directory": "libraries/typescript/packages/cli"
  },
  "bugs": {
    "url": "https://github.com/mcp-use/mcp-use/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli"
  ],
  "bin": {
    "mcp-use-cli": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite-client": {
      "types": "./types/vite-client.d.ts"
    }
  },
  "files": [
    "dist",
    "types"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "rimraf dist && tsup --config tsup.config.ts && node scripts/verify-package.mjs",
    "test": "node --test tests/proxy.test.mjs && vitest run",
    "test:run": "npm run typecheck && npm test",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@modelcontextprotocol/server": "2.0.0",
    "tailwindcss": "^4.2.0",
    "vite": "^8.0.16"
  },
  "peerDependencies": {
    "@mcp-use/client": "^2.0.2-canary.0",
    "@mcp-use/inspector": "^20.0.2-canary.0"
  },
  "peerDependenciesMeta": {
    "@mcp-use/client": {
      "optional": true
    },
    "@mcp-use/inspector": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mcp-use/client": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
