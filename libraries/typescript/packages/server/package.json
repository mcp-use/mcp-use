{
  "name": "@mcp-use/server",
  "type": "module",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "MCP server framework built on the official v2 SDK (2026-07-28 stateless protocol) and Hono. Greenfield rebuild of the mcp-use server package; renamed to `mcp-use` at v2 cutover.",
  "author": "mcp-use, Inc.",
  "license": "MIT",
  "homepage": "https://github.com/mcp-use/mcp-use#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcp-use/mcp-use.git",
    "directory": "libraries/typescript/packages/server"
  },
  "bugs": {
    "url": "https://github.com/mcp-use/mcp-use/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "server",
    "hono",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-use": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsup && tsc --emitDeclarationOnly --declaration",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "npm run typecheck && vitest run",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "@modelcontextprotocol/hono": "2.0.0-beta.2",
    "@modelcontextprotocol/server": "2.0.0-beta.2",
    "hono": "^4.12.27"
  },
  "peerDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/ext-apps": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mcp-use/server": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0-beta.2",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.10.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "7.0.1-rc",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  }
}
