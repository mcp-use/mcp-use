{
  "name": "mcp-use",
  "type": "module",
  "version": "2.0.0-beta.13",
  "description": "MCP framework and CLI built on the official v2 SDK",
  "author": "mcp-use, Inc.",
  "license": "MIT",
  "homepage": "https://github.com/mcp-use/mcp-use#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcp-use/mcp-use.git",
    "directory": "libraries/typescript/packages/server"
  },
  "bugs": {
    "url": "https://github.com/mcp-use/mcp-use/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "server",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./landing": {
      "types": "./dist/landing.d.ts",
      "import": "./dist/landing.js"
    },
    "./oauth": {
      "types": "./dist/oauth/index.d.ts",
      "import": "./dist/oauth/index.js"
    },
    "./oauth/clerk": {
      "types": "./dist/oauth/clerk.d.ts",
      "import": "./dist/oauth/clerk.js"
    },
    "./oauth/auth0": {
      "types": "./dist/oauth/auth0.d.ts",
      "import": "./dist/oauth/auth0.js"
    },
    "./oauth/workos": {
      "types": "./dist/oauth/workos.d.ts",
      "import": "./dist/oauth/workos.js"
    },
    "./oauth/supabase": {
      "types": "./dist/oauth/supabase.d.ts",
      "import": "./dist/oauth/supabase.js"
    },
    "./oauth/keycloak": {
      "types": "./dist/oauth/keycloak.d.ts",
      "import": "./dist/oauth/keycloak.js"
    },
    "./oauth/better-auth": {
      "types": "./dist/oauth/better-auth.d.ts",
      "import": "./dist/oauth/better-auth.js"
    },
    "./node": {
      "types": "./dist/node-bridge.d.ts",
      "import": "./dist/node-bridge.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-use": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "rimraf dist && tsup && tsc --emitDeclarationOnly --declaration",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "npm run typecheck && vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "doctor": "npx react-doctor@latest"
  },
  "bundledDependencies": [
    "@modelcontextprotocol/client"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "https://pkg.pr.new/@modelcontextprotocol/client@f60b40179b0f090f6d64248be1312245a160b5ee",
    "@modelcontextprotocol/core": "https://pkg.pr.new/@modelcontextprotocol/core@f60b40179b0f090f6d64248be1312245a160b5ee",
    "@modelcontextprotocol/ext-apps": "https://pkg.pr.new/@modelcontextprotocol/ext-apps@432d42bb02a569078ab31ab6458428df6027809d",
    "@modelcontextprotocol/server": "https://pkg.pr.new/@modelcontextprotocol/server@f60b40179b0f090f6d64248be1312245a160b5ee",
    "@tailwindcss/vite": "^4.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jose": "^6.1.3",
    "tailwindcss": "^4.2.0",
    "vite": "^8.0.16"
  },
  "peerDependencies": {
    "@mcp-use/client": "^2.0.0-alpha.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@mcp-use/client": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mcp-use/client": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.10.6",
    "mcp-use": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
