{
  "$schema": "https://react.doctor/schema/config.json",
  // Scan the mcp-use React runtime and view examples only.
  // Non-React server/CLI sources and generated workspaces are excluded.
  "ignore": {
    "files": [
      "dist/**",
      "node_modules/**",
      "**/.mcp-use/**",
      "tests/cli/**",
      "examples/railway/**",
      "examples/vercel/**",
      "src/*.ts",
      "src/bin/**",
      "src/cli/**",
      "src/views/**"
    ]
  }
}
