# Firebase project (Firebase console > Project settings > General > Your apps
# > Web app > SDK setup and configuration). The web API key is not a secret,
# but the server also uses it to refresh ID tokens: if the key has API
# restrictions, allow the Identity Toolkit API and the Token Service API, and
# do not restrict it to HTTP referrers.
MCP_USE_FIREBASE_API_KEY=
# For example my-app.firebaseapp.com, without https://.
MCP_USE_FIREBASE_AUTH_DOMAIN=
MCP_USE_FIREBASE_PROJECT_ID=

# Encryption and cookie secret, at least 32 characters:
#   openssl rand -base64 32
MCP_USE_OAUTH_SECRET=

# Optional: the MCP clients that may connect, comma-separated. Each entry is a
# client ID metadata document URL or an https origin. Unset lets any client
# connect, through a metadata document or dynamic client registration.
# MCP_USE_ALLOWED_CLIENTS=https://claude.ai,https://chatgpt.com

# Public origin only, with no path. Required behind a tunnel or when deployed,
# together with the Redis store below. Add its host to the authorized domains
# of Firebase Authentication.
# MCP_URL=https://mcp.example.com

# Redis 6.2 or later. Unset keeps sign-ins in memory, which works only on
# localhost.
# MCP_USE_REDIS_URL=redis://localhost:6379

# Local development only: the Firebase emulators. With the Auth emulator set,
# the server accepts its unsigned ID tokens, so it runs only on localhost. Use
# a demo- project ID, for example MCP_USE_FIREBASE_PROJECT_ID=demo-mcp-use.
# MCP_USE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# MCP_USE_FIRESTORE_EMULATOR_URL=http://127.0.0.1:8080
