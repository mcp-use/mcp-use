# Firebase project. These values run against the Firebase emulators:
#   npx -y firebase-tools@15.33.0 emulators:start --project demo-mcp-use
# For a real project, use its web app config and remove the emulator URLs.
MCP_USE_FIREBASE_PROJECT_ID=demo-mcp-use
MCP_USE_FIREBASE_API_KEY=demo-api-key
MCP_USE_FIREBASE_AUTH_DOMAIN=demo-mcp-use.firebaseapp.com
MCP_USE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
MCP_USE_FIRESTORE_EMULATOR_URL=http://127.0.0.1:8080

# Encryption and cookie secret, at least 32 characters:
#   openssl rand -base64 32
MCP_USE_OAUTH_SECRET=

# Optional: the MCP clients that may connect, comma-separated. Each entry is a
# client ID metadata document URL or an https origin.
# MCP_USE_ALLOWED_CLIENTS=https://claude.ai,https://chatgpt.com

# Public origin only, with no path. Required behind a tunnel or when deployed.
# MCP_URL=https://mcp.example.com
