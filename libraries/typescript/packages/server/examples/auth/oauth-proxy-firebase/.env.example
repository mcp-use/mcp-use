# Google OAuth client (Google Cloud console > APIs & Services > Credentials),
# in the Google Cloud project of the Firebase project. Its redirect URI must be
# <MCP_URL>/mcp/oauth/callback, for local development
# http://localhost:3000/mcp/oauth/callback.
MCP_USE_GOOGLE_CLIENT_ID=
MCP_USE_GOOGLE_CLIENT_SECRET=

# Firebase project that holds Firestore.
MCP_USE_FIREBASE_PROJECT_ID=

# Path to a service account key (Project settings > Service accounts), for
# running outside Google Cloud. Keep it out of the repository.
MCP_USE_FIREBASE_CREDENTIALS=

# Encryption and cookie secret, at least 32 characters:
#   openssl rand -base64 32
MCP_USE_OAUTH_SECRET=

# Optional: the MCP clients that may connect, comma-separated. Each entry is a
# client ID metadata document URL or an https origin.
# MCP_USE_ALLOWED_CLIENTS=https://claude.ai,https://chatgpt.com

# Public origin only, with no path. Required behind a tunnel or when deployed.
# MCP_URL=https://mcp.example.com
