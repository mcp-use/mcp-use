# Required: the base URL of your Convex OAuth Provider deployment.
# This is the URL of the Convex site where your OAuth provider component is hosted.
# Example: https://your-deployment-name.convex.site/oauth
MCP_USE_OAUTH_CONVEX_AUTH_URL=https://your-deployment-name.convex.site/oauth

# Optional: public MCP server origin. Do not include /mcp.
# MCP_URL=https://mcp.example.com
