# Firebase Console > Project settings > Your apps > Web app configuration.
FIREBASE_WEB_CONFIG_FILE=./firebase-config.json

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Alternatively, omit BETTER_AUTH_SECRET and set BETTER_AUTH_SECRET_FILE.
# BETTER_AUTH_SECRET_FILE=/path/to/better-auth-secret

# Local development only. Production requires DATABASE_URL instead.
SQLITE_FILE=./.mcp-use/auth.sqlite
# DATABASE_URL=postgresql://user:password@localhost:5432/mcp_auth

# Public origin, without /mcp. Use HTTPS outside loopback development.
MCP_URL=http://localhost:3038
