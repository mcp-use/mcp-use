# This server's public origin (not the /mcp path). Lane mints tokens audienced
# to <origin>/mcp, and Lane must have claimed this exact host. Required for any
# deployment or tunnel; omit only for plain local runs.
MCP_URL=https://your-server.example

# A CONFIDENTIAL Lane client with the token-exchange grant, used only by
# lane_register_session. Ask Lane for one; DCR-registered clients cannot exchange.
MCP_USE_OAUTH_LANE_CLIENT_ID=
MCP_USE_OAUTH_LANE_CLIENT_SECRET=

# Lane's authorization server. Omit for production.
# MCP_USE_OAUTH_LANE_ISSUER=https://auth.getonlane.com/auth/mcp

# `gate-all` (default) refuses tools until the step-up; `log-only` never refuses
# and prints would-have-blocked gate events instead.
# LANE_ENFORCEMENT=gate-all

# Lane's Order API, called by lane_checkout with the caller's own bearer.
# LANE_MCP_BASE_URL=https://mcp.getonlane.com

# UCP catalog and Lane index endpoints used by the ucp_* tools.
# UCP_CATALOG_ENDPOINT=https://catalog.shopify.com/api/ucp/mcp
# UCP_AGENT_PROFILE_URL=https://www.getonlane.com/.well-known/ucp-agent-profile.json
# UCP_CHECKOUT_PROFILE_URL=
# LANE_DISCOVERY_BASE=https://discovery.getonlane.com
# LANE_EVENTS_KEY=
