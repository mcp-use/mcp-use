# Keycloak base URL. Include a legacy /auth path if your deployment uses one.
KEYCLOAK_SERVER_URL=https://keycloak.example.com
KEYCLOAK_REALM=mcp

# Optional: require an access-token audience, usually your Keycloak API client ID.
# KEYCLOAK_AUDIENCE=mcp-api

# Set this in public deployments so OAuth protected-resource metadata advertises
# the canonical public MCP endpoint.
# MCP_URL=https://mcp.example.com
