{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "rules": {
    "optionalPeerDependencies": "off",
    "exports": "warn",
    "types": "warn"
  },
  "ignoreWorkspaces": [
    "packages/client/examples/**",
    "packages/create-mcp-use-app/src/templates/**",
    "packages/server/examples/**",
    "test_app"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/version-packages.mjs"],
      "project": ["*.{js,ts}"]
    },
    "packages/server": {
      "entry": [
        "src/index.ts",
        "src/bin.ts",
        "src/react/index.ts",
        "src/vite-client.ts",
        "src/oauth/**/*.ts",
        "tests/**/*.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"],
      "ignoreBinaries": ["npx"],
      "ignoreUnresolved": ["#mcp-use-node-http"],
      "ignoreDependencies": ["mcp-use"]
    },
    "packages/agent": {
      "entry": [
        "src/index.ts",
        "src/langchain.ts",
        "tests/**/*.ts",
        "examples/**/*.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts", "examples/**/*.ts"]
    },
    "packages/tunnel": {
      "entry": ["src/index.ts", "src/bin.ts", "tests/**/*.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["src/index.ts", "tests/**/*.mjs"],
      "project": ["src/**/*.ts", "tests/**/*.mjs"],
      "ignoreDependencies": [
        "@mcp-use/tunnel",
        "@modelcontextprotocol/server",
        "@tailwindcss/vite",
        "@vitejs/plugin-react",
        "tailwindcss",
        "vite"
      ]
    },
    "packages/client": {
      "entry": [
        "src/index.ts",
        "src/index-browser.ts",
        "src/react/index.ts",
        "tests/**/*.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "packages/inspector": {
      "entry": [
        "src/server/*.ts",
        "start-auth-servers.ts",
        "tests/e2e/**/*.{ts,tsx,mjs}"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "inspector-rate-limiter-memory",
        "tailwindcss",
        "tw-animate-css"
      ]
    },
    "packages/create-mcp-use-app": {
      "entry": ["scripts/**/*.{js,mjs,ts}", "src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
